# Backend — copy to .env and fill in (never commit .env)
PORT=5000
JWT_SECRET=your_jwt_secret_here

# MongoDB replication (RxDB replication-mongodb plugin, optional).
# When MONGODB_URI is set, every RxDB collection replicates two-way + live
# to the MongoDB database; when unset, the backend uses local SQLite only.
# The MongoDB deployment must support change streams (replica set / Atlas).
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=restaurant
# MONGODB_REPLICATION_BATCH_SIZE=50
# MONGODB_REPLICATION_RETRY_MS=5000
# MONGODB_REPLICATION_LIVE=true

# ---------------------------------------------------------------------------
# AI virtual waitress (optional; disabled by default)
# ---------------------------------------------------------------------------
# Enable the /assistant UI and /api/ai endpoints only after the LLM settings
# below are valid. Startup validation logs errors but never crashes the API.
# AI_ENABLED=false

# OpenAI-compatible chat endpoint. Use an absolute URL ending in /v1:
#   hosted:  https://api.openai.com/v1
#   Ollama:  http://localhost:11434/v1
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_API_KEY=your_llm_api_key_here
# AI_LLM_MODEL=gpt-4o-mini
# AI_LLM_TIMEOUT_MS=30000
# AI_LLM_TEMPERATURE=0.2

# Embeddings for retrieval-augmented knowledge. Falls back to
# AI_LLM_BASE_URL/AI_LLM_API_KEY when these are omitted.
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_API_KEY=your_embedding_api_key_here
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_TIMEOUT_MS=30000

# Retrieval and safety limits.
# AI_RAG_ENABLED=true
# AI_RAG_TOP_K=5
# AI_RAG_MIN_SCORE=0.2
# AI_RAG_CHUNK_SIZE=800
# AI_RAG_CHUNK_OVERLAP=120
# AI_RAG_MAX_CHUNKS=5000
# AI_AUTO_SEED_KNOWLEDGE=false
# AI_MAX_ITERATIONS=5
# AI_MAX_TOOL_CALLS_PER_TURN=4
# AI_TOOL_TIMEOUT_MS=10000
# AI_REQUEST_TIMEOUT_MS=60000
# AI_MAX_TOOL_RESULT_CHARS=12000
# AI_MAX_HISTORY_MESSAGES=12
# AI_MAX_MESSAGE_CHARS=4000
# AI_RESTAURANT_TIMEZONE=UTC
# AI_MAX_PARTY_SIZE=20
# AI_DRAFT_TTL_MS=900000

# Per-IP rate limits (window in milliseconds).
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=20
# AI_CONFIRM_RATE_LIMIT_MAX=10
# AI_ADMIN_RATE_LIMIT_MAX=30
