# Backend — copy to .env and fill in (never commit .env)
PORT=5000
JWT_SECRET=your_jwt_secret_here

# MongoDB replication (RxDB replication-mongodb plugin, optional).
# When MONGODB_URI is set, every RxDB collection replicates two-way + live
# to the MongoDB database; when unset, the backend uses local SQLite only.
# The MongoDB deployment must support change streams (replica set / Atlas).
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=restaurant
# MONGODB_REPLICATION_BATCH_SIZE=50
# MONGODB_REPLICATION_RETRY_MS=5000
# MONGODB_REPLICATION_LIVE=true
