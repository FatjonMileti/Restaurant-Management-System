# Frontend — local dev defaults (CRA proxy forwards to the backend instead,
# so these can stay commented out; uncomment to point at a remote backend)
# REACT_APP_GRAPHQL_URL=http://localhost:5000/graphql
# REACT_APP_WS_URL=http://localhost:5000

# Production behind Caddy (same-origin, see docs/DEPLOYMENT.md) — set at build time:
# REACT_APP_GRAPHQL_URL=/graphql
# REACT_APP_WS_URL=
