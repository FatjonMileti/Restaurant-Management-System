# Frontend — local dev defaults (CRA proxy forwards to the backend instead,
# so these can stay commented out; uncomment to point at a remote backend)
# REACT_APP_GRAPHQL_URL=http://localhost:5000/graphql
# REACT_APP_WS_URL=http://localhost:5000
# Images resolve against this base (bare filenames like `restaurant.jpeg`
# become `<REACT_APP_API_URL>/images/restaurant.jpeg`; empty = same-origin)
# REACT_APP_API_URL=http://localhost:5000

# HOST=my-local-app.dev

# DANGEROUSLY_DISABLE_HOST_CHECK=true

# Demo: frontend served from backend server.ts (single-origin, single port).
# The backend serves the frontend build itself (see backend/server.ts), so
# build with same-origin URLs and move the output into backend/public —
# then just run the backend, no Caddy needed:
#   npm run build:frontend   (from the repo root)
#   npm --prefix backend start
# REACT_APP_GRAPHQL_URL=/graphql
# REACT_APP_WS_URL=
# REACT_APP_API_URL=

# Production behind Caddy (same-origin, see docs/DEPLOYMENT.md) — set at build time:
# REACT_APP_GRAPHQL_URL=/graphql
# REACT_APP_WS_URL=
# REACT_APP_API_URL=
